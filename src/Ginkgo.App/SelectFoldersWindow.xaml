<Window x:Class="Ginkgo.App.SelectFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select folders" Width="520" Height="680" Background="#1C1C20" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <CheckBox x:Name="AllBox" IsThreeState="True" Content="All folders" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4" Click="OnAllClick"/>
            <TextBlock Text="Green means shown. Turning a folder off hides it and everything inside it. Counts follow the NSFW and Very switches."
                       Foreground="#9AA0A6" TextWrapping="Wrap" Margin="0,0,0,8"/>
        </StackPanel>
        <TreeView x:Name="Tree" Grid.Row="1" Background="#121214" BorderThickness="0" Foreground="White">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="True" VerticalAlignment="Center" Margin="0,2,8,2"/>
                        <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CountText}" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Click="OnOk"/>
            <Button Content="Cancel" Width="80" Margin="0" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
