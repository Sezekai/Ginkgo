<Window x:Class="Ginkgo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ginkgo.App"
        Title="Ginkgo" Width="1400" Height="900" MinWidth="720" MinHeight="480" Background="#121214"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="OnKey">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- notices: library missing, or a big removal that was held back -->
        <Border x:Name="Banner" Grid.Row="0" Background="#5A4A1E" Padding="12,6" Visibility="Collapsed">
            <DockPanel>
                <StackPanel x:Name="BannerButtons" Orientation="Horizontal" DockPanel.Dock="Right"/>
                <TextBlock x:Name="BannerText" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Bar}" Padding="10,8">
            <WrapPanel Orientation="Horizontal">
                <ToggleButton x:Name="NavHome" Content="Home" IsChecked="True"/>
                <ToggleButton Content="Browse" IsEnabled="False" ToolTip="Coming in the next build"/>
                <ToggleButton Content="Favourites" IsEnabled="False" ToolTip="Coming in a later build"/>
                <ToggleButton Content="Tools" IsEnabled="False" ToolTip="Coming in a later build"/>
                <Rectangle Width="1" Fill="#3A3A42" Margin="6,2,12,2"/>
                <Button x:Name="FoldersBtn" Content="Select folders" Click="OnFolders"/>
                <ToggleButton x:Name="ImagesBtn" Content="Images" IsChecked="True" Click="OnFilterChanged"/>
                <ToggleButton x:Name="GifsBtn" Content="GIFs" IsChecked="True" Click="OnFilterChanged"/>
                <ToggleButton x:Name="NsfwBtn" Content="NSFW" Click="OnFilterChanged" ToolTip="Show NSFW files (N)"/>
                <ToggleButton x:Name="VeryBtn" Content="Very" Click="OnFilterChanged" ToolTip="Show Very files (V)"/>
                <Rectangle Width="1" Fill="#3A3A42" Margin="6,2,12,2"/>
                <TextBlock Text="Search" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="SearchBox" Width="190" Margin="0,0,12,0" VerticalContentAlignment="Center" TextChanged="OnSearchChanged"/>
                <TextBlock Text="Sort" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SortBox" Width="150" Margin="0,0,6,0" SelectionChanged="OnSortChanged">
                    <ComboBoxItem Content="Newest first seen" Tag="FirstSeen"/>
                    <ComboBoxItem Content="Newest modified" Tag="Modified"/>
                    <ComboBoxItem Content="Name A to Z" Tag="Name"/>
                    <ComboBoxItem Content="Largest file" Tag="SizeDesc"/>
                    <ComboBoxItem Content="Smallest file" Tag="SizeAsc"/>
                    <ComboBoxItem Content="Most pixels" Tag="Largest"/>
                    <ComboBoxItem Content="Random" Tag="Random"/>
                </ComboBox>
                <Button x:Name="ShuffleBtn" Content="Reshuffle" Visibility="Collapsed" Click="OnReshuffle"/>
                <TextBlock Text="Size" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="6,0,6,0"/>
                <Slider x:Name="SizeSlider" Width="130" Minimum="80" Maximum="700" VerticalAlignment="Center" Margin="0,0,12,0" ValueChanged="OnSizeChanged"/>
                <Button x:Name="SettingsBtn" Content="Settings" Click="OnSettings"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <local:MasonryView x:Name="View"/>
            <ScrollBar x:Name="Bar" Grid.Column="1" Orientation="Vertical" Width="16" ValueChanged="OnBarChanged"/>
            <TextBlock x:Name="EmptyNote" Grid.ColumnSpan="2" Foreground="{StaticResource Dim}" FontSize="16" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource Bar}" Padding="10,5">
            <DockPanel>
                <Button x:Name="UpdateBtn" DockPanel.Dock="Right" Content="Update view" Visibility="Collapsed" Margin="8,0,0,0" Click="OnUpdateView"/>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource Text}" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- viewer -->
        <Grid x:Name="ViewerRoot" Grid.RowSpan="4" Background="Black" Visibility="Collapsed" Focusable="True">
            <Grid x:Name="PicHost" ClipToBounds="True" Background="Black" MouseWheel="OnViewerWheel" MouseLeftButtonDown="OnViewerDown"
                  MouseMove="OnViewerMove" MouseLeftButtonUp="OnViewerUp">
                <Image x:Name="Pic" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PicScale"/>
                            <TranslateTransform x:Name="PicMove"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="ViewerNote" Foreground="#C0C0C0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </Grid>
            <Border x:Name="ViewerBar" VerticalAlignment="Top" Background="#CC000000" Padding="12,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Close (Esc)" Click="OnViewerClose"/>
                    <TextBlock x:Name="ViewerTitle" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <Border x:Name="InfoPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,12,0" Background="#E6101014" Padding="14,10" MinWidth="280" Visibility="Collapsed">
                <TextBlock x:Name="InfoText" Foreground="White" FontFamily="Consolas" TextWrapping="Wrap" MaxWidth="460"/>
            </Border>
            <TextBlock x:Name="ViewerHint" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="#80FFFFFF"
                       Text="Arrows: previous / next    0: fit    1: 100%    I: info    H: hide interface    F: full screen    Esc: close"/>
        </Grid>
    </Grid>
</Window>
