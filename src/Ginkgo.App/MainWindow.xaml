<Window x:Class="Ginkgo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Ginkgo.App"
        Title="Ginkgo" Icon="Assets/ginkgo.ico" Width="1400" Height="900" MinWidth="760" MinHeight="480" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="OnKey" StateChanged="OnStateChanged"
        FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource AppFontSize}" TextElement.Foreground="{DynamicResource Text}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowEdge" BorderBrush="#4A4A54" BorderThickness="0">
    <Grid x:Name="Frame">
    <DockPanel>
    <!-- the window's own title bar: name on the left, window buttons flush in the top-right corner -->
    <Grid x:Name="TitleBar" DockPanel.Dock="Top" Panel.ZIndex="1" Height="29" Background="{DynamicResource BarBack}" MouseLeftButtonDown="OnTitleDown" MouseMove="OnTitleMove" MouseLeftButtonUp="OnTitleUp">
        <Border x:Name="TitleLine" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Edge}" IsHitTestVisible="False"/>
        <TextBlock x:Name="TitleText" Text="Ginkgo" FontSize="12" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="14,0,0,1" IsHitTestVisible="False"/>
        <!-- the window buttons: can have an outline round them, and their own size (Appearance → Top bar) -->
        <Border x:Name="CaptionFrame" HorizontalAlignment="Right" BorderBrush="{DynamicResource Edge}" BorderThickness="0">
            <StackPanel x:Name="CaptionBox" Orientation="Horizontal">
                <Button x:Name="MinBtn" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimise"/>
                <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximise"/>
                <Button x:Name="CloseBtn" Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close"/>
            </StackPanel>
        </Border>
    </Grid>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- the picture grid fills the window; the bar floats over its top -->
        <Grid Grid.Row="0">
            <local:MasonryView x:Name="View"/>
            <ScrollBar x:Name="Scroll" Style="{StaticResource HoverBar}" Orientation="Vertical" HorizontalAlignment="Right" ValueChanged="OnBarChanged"/>
            <!-- the scrubber's label: where you are in the list while dragging the scroll bar -->
            <Border x:Name="ScrubBubble" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,4" CornerRadius="6" Background="#E6202026"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="ScrubText" Foreground="White" FontSize="13"/>
            </Border>
            <TextBlock x:Name="EmptyNote" Foreground="{DynamicResource Dim}" FontSize="16" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Visibility="Collapsed"/>
        </Grid>

        <!-- Appearance and Settings: sections of their own, under the top bar -->
        <Border x:Name="PageHost" Grid.Row="0" Panel.ZIndex="1" Visibility="Collapsed" Background="{DynamicResource WindowBg}"/>

        <Border x:Name="StatusBar" Grid.Row="1" Background="{DynamicResource BarBack}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <Button x:Name="UpdateBtn" DockPanel.Dock="Right" Content="Update view" Visibility="Collapsed" Margin="8,0,0,0" Padding="8,2" Click="OnUpdateView"/>
                <Button x:Name="DiagMoreBtn" DockPanel.Dock="Right" Content="Full status" Visibility="Collapsed" Margin="8,0,0,0" Padding="8,0" Height="22" ToolTip="Show the whole F3 status" Click="OnDiagMore"/>
                <TextBlock x:Name="DiagText" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" Foreground="#E0B060" FontFamily="Consolas" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <!-- a file operation under way: how many, the share done, the time taken and the time left -->
                <TextBlock x:Name="OpText" DockPanel.Dock="Right" Foreground="{DynamicResource Text}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <ProgressBar x:Name="OpBar" DockPanel.Dock="Right" Width="160" Minimum="0" Maximum="1" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{DynamicResource Text}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <ProgressBar x:Name="IdBar" DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="1" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                <ProgressBar x:Name="DetailsBar" DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="1" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Reading photo dates or looking for copies of the same file"/>
                <ProgressBar x:Name="FavBar" DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="1" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Favourites: checking or copying"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- the top bar: also the window's title bar. It slides away when you scroll down. -->
        <StackPanel x:Name="BarHost" Grid.RowSpan="2" VerticalAlignment="Top">
            <StackPanel.RenderTransform><TranslateTransform x:Name="BarShift"/></StackPanel.RenderTransform>
            <Border x:Name="TopBar" Background="{DynamicResource BarBack}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleDown" MouseMove="OnTitleMove" MouseLeftButtonUp="OnTitleUp">
                <local:BarPanel x:Name="BarRow" Margin="14,10,10,10" VerticalAlignment="Center">
                        <local:LogoView x:Name="Logo" local:BarPanel.Pinned="True" Margin="6,0,14,0" VerticalAlignment="Center" ToolTip="Ginkgo"/>
                        <local:SectionSwitch x:Name="Sections" local:BarPanel.Pinned="True" Height="44" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <Border x:Name="SectionTitleBox" local:BarPanel.Pinned="True" Height="44" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SectionTitle" Text="Home" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,0,2"/>
                        </Border>
                        <Button x:Name="FoldersBtn" Style="{StaticResource DropButton}" Content="Folders" Height="{DynamicResource KeyHeight}" Margin="0,3,6,3" VerticalAlignment="Center" Click="OnFolders"/>
                        <!-- Images, GIFs and Videos side by side, still separate buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,6,3" VerticalAlignment="Center">
                            <ToggleButton x:Name="ImagesBtn" Content="Images" Height="{DynamicResource KeyHeight}" Margin="0,0,3,0" VerticalAlignment="Center" IsChecked="True" Click="OnFilterChanged"/>
                            <ToggleButton x:Name="GifsBtn" Content="GIFs" Height="{DynamicResource KeyHeight}" Margin="0,0,3,0" VerticalAlignment="Center" IsChecked="True" Click="OnFilterChanged"/>
                            <ToggleButton x:Name="VideosBtn" Style="{StaticResource SplitLeft}" Content="Videos" Height="{DynamicResource KeyHeight}" VerticalAlignment="Center" IsChecked="True" Click="OnFilterChanged"/>
                            <Button x:Name="VideosMoreBtn" Style="{StaticResource SplitRight}" Tag="{Binding IsChecked, ElementName=VideosBtn}" Height="{DynamicResource KeyHeight}"
                                    VerticalAlignment="Center" ToolTip="Which videos to show: watched, paused, not watched" Click="OnVideosMore"/>
                        </StackPanel>
                        <!-- General, NSFW and Very side by side -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,10,3" VerticalAlignment="Center">
                            <ToggleButton x:Name="GeneralBtn" Style="{StaticResource ContentToggle}" Content="General" Height="{DynamicResource KeyHeight}" Margin="0,0,3,0" VerticalAlignment="Center" IsChecked="True" Click="OnFilterChanged" ToolTip="Show General files (G)"/>
                            <ToggleButton x:Name="NsfwBtn" Style="{StaticResource SplitLeftC}" Content="NSFW" Height="{DynamicResource KeyHeight}" VerticalAlignment="Center" Click="OnFilterChanged" ToolTip="Show NSFW files (N)"/>
                            <Button x:Name="NsfwMoreBtn" Style="{StaticResource SplitRightC}" Tag="{Binding IsChecked, ElementName=NsfwBtn}" Height="{DynamicResource KeyHeight}"
                                    VerticalAlignment="Center" ToolTip="NSFW folder by folder" Click="OnNsfwMore" Margin="0,0,3,0"/>
                            <ToggleButton x:Name="VeryBtn" Style="{StaticResource SplitLeftC}" Content="Very" Height="{DynamicResource KeyHeight}" VerticalAlignment="Center" Click="OnFilterChanged" ToolTip="Show Very files (V)"/>
                            <Button x:Name="VeryMoreBtn" Style="{StaticResource SplitRightC}" Tag="{Binding IsChecked, ElementName=VeryBtn}" Height="{DynamicResource KeyHeight}"
                                    VerticalAlignment="Center" ToolTip="Very folder by folder" Click="OnVeryMore"/>
                        </StackPanel>
                        <TextBox x:Name="SearchBox" local:BarPanel.PreferredWidth="150" MinWidth="64" Height="{DynamicResource KeyHeight}" Margin="0,3,10,3" VerticalAlignment="Center" VerticalContentAlignment="Center" TextChanged="OnSearchChanged" ToolTip="Search file and folder names (/ or Ctrl+F)"/>
                        <Button x:Name="FiltersBtn" Style="{StaticResource DropButton}" Content="Filters" Height="{DynamicResource KeyHeight}" Margin="0,3,6,3" VerticalAlignment="Center" Click="OnFilters" ToolTip="Format, size, dimensions, shape, video length, dates, favourites, sets"/>
                        <ComboBox x:Name="SortBox" local:BarPanel.PreferredWidth="120" MinWidth="88" Margin="0,3,3,3" Height="{DynamicResource KeyHeight}" VerticalAlignment="Center" SelectionChanged="OnSortChanged" ToolTip="Order">
                            <ComboBoxItem Content="First seen" Tag="FirstSeen"/>
                            <ComboBoxItem Content="Modified" Tag="Modified"/>
                            <ComboBoxItem Content="Created" Tag="Created"/>
                            <ComboBoxItem Content="Date taken" Tag="Taken"/>
                            <ComboBoxItem Content="Name" Tag="Name"/>
                            <ComboBoxItem Content="Folder" Tag="Folder"/>
                            <ComboBoxItem Content="File size" Tag="Size"/>
                            <ComboBoxItem Content="Width" Tag="Width"/>
                            <ComboBoxItem Content="Height" Tag="Height"/>
                            <ComboBoxItem Content="Megapixels" Tag="Megapixels"/>
                            <ComboBoxItem Content="Video length" Tag="Duration"/>
                            <ComboBoxItem Content="Random" Tag="Random"/>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,3,6,3" VerticalAlignment="Center">
                            <ToggleButton x:Name="SortRevBtn" Style="{StaticResource ArrowToggle}" Width="{DynamicResource IconSize}" Height="{DynamicResource KeyHeight}" Margin="0,0,3,0" VerticalAlignment="Center" Click="OnSortRev" ToolTip="Reverse the order"/>
                            <Button x:Name="ShuffleBtn" Style="{StaticResource BarIcon}" Content="&#xE8B1;" Height="{DynamicResource KeyHeight}" Margin="0" VerticalAlignment="Center" Visibility="Collapsed" Click="OnReshuffle" ToolTip="Reshuffle"/>
                        </StackPanel>
                        <Slider x:Name="SizeSlider" local:BarPanel.PreferredWidth="110" MinWidth="50" Minimum="0" Maximum="1" Margin="4,3,8,3" VerticalAlignment="Center" ValueChanged="OnSizeChanged" ToolTip="Picture size (Ctrl + mouse wheel, + and -)"/>
                        <!-- Grid, Fit and Equal rows side by side -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,6,3" VerticalAlignment="Center">
                            <ToggleButton x:Name="GridLayoutBtn" Content="Grid" Height="{DynamicResource KeyHeight}" Margin="0,0,3,0" VerticalAlignment="Center" Click="OnGridLayout" ToolTip="Square cells of one size"/>
                            <ToggleButton x:Name="FitBtn" Content="Fit" Height="{DynamicResource KeyHeight}" Margin="0,0,3,0" VerticalAlignment="Center" Click="OnGridFit" Visibility="Collapsed" ToolTip="On: whole pictures inside their cells. Off: pictures cropped to fill them"/>
                            <ToggleButton x:Name="RowsBtn" Content="Equal rows" Height="{DynamicResource KeyHeight}" Margin="0" VerticalAlignment="Center" Click="OnLayoutChanged" ToolTip="Rows of equal height instead of equal-width columns (L)"/>
                        </StackPanel>
                        <Button x:Name="ViewsBtn" Style="{StaticResource DropButton}" Content="Views" Height="{DynamicResource KeyHeight}" Margin="0,3,4,3" VerticalAlignment="Center" ToolTip="Saved views: open one, save this view, update, rename or delete" Click="OnViewsMenu"/>
                        <Button x:Name="ResetViewBtn" Style="{StaticResource BarIcon}" Content="&#xE72C;" Height="{DynamicResource KeyHeight}" Margin="0,3,3,3" VerticalAlignment="Center" ToolTip="Return to default: this section's own sort, filters, layout and size" Click="OnReturnToDefaultBtn"/>
                        <Button x:Name="SaveViewBtn" Style="{StaticResource BarIcon}" Content="&#xE710;" Height="{DynamicResource KeyHeight}" Margin="0,3,3,3" VerticalAlignment="Center" ToolTip="Save this view… (everything about it, under a name)" Click="OnSaveSearch"/>
                        <Button x:Name="SaveDefaultBtn" Style="{StaticResource BarIcon}" Content="&#xE74E;" Height="{DynamicResource KeyHeight}" Margin="0,3,6,3" VerticalAlignment="Center" ToolTip="Save as default: how this section looks now becomes what it starts with" Click="OnSaveAsDefaultBtn"/>
                        <Button x:Name="SlideshowBtn" Style="{StaticResource BarIcon}" Content="&#xE786;" Height="{DynamicResource KeyHeight}" Margin="0,3,3,3" VerticalAlignment="Center" ToolTip="Slideshow: how long each picture shows, videos and GIFs, then Start" Click="OnSlideshow"/>
                        <Button x:Name="PauseAllBtn" Style="{StaticResource BarIcon}" Content="&#xE769;" Height="{DynamicResource KeyHeight}" Margin="0,3,3,3" VerticalAlignment="Center" ToolTip="Pause every playing video" Click="OnPauseAll" Visibility="Collapsed"/>
                        <Button x:Name="QuickBtn" Style="{StaticResource BarIcon}" Content="&#xE9E9;" Height="{DynamicResource KeyHeight}" Margin="0,3,3,3" VerticalAlignment="Center" ToolTip="Quick toggles: videos (Q)" Click="OnQuick"/>
                        <Button x:Name="OptimiseBtn" Style="{StaticResource BarIcon}" Content="&#xE9D9;" Height="{DynamicResource KeyHeight}" Margin="0,3,3,3" VerticalAlignment="Center" ToolTip="Optimisations: memory and GIFs" Click="OnOptimise"/>
                        <Button x:Name="KeysBtn" Style="{StaticResource BarIcon}" Content="&#xE765;" Height="{DynamicResource KeyHeight}" Margin="0,3,6,3" VerticalAlignment="Center" ToolTip="Keyboard shortcuts (K)" Click="OnKeysClick"/>
                        <Button x:Name="MoreBtn" local:BarPanel.Pinned="True" Style="{StaticResource BarIcon}" Content="&#xE712;" Height="{DynamicResource KeyHeight}" Margin="0,3,3,3" VerticalAlignment="Center" ToolTip="More" Click="OnMoreBar"/>
                        <Button x:Name="HideBarBtn" local:BarPanel.Pinned="True" Style="{StaticResource BarIcon}" Content="&#xE70E;" Height="{DynamicResource KeyHeight}" Margin="0,3,3,3" VerticalAlignment="Center" ToolTip="Hide this bar (H). Press H again to hide the bottom bar too, and once more to bring both back" Click="OnHideBar"/>
                    </local:BarPanel>
            </Border>
            <!-- the filters in use, each with an x, and Clear all -->
            <Border x:Name="ChipBar" Background="{DynamicResource BarBack}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1" Padding="14,6" Visibility="Collapsed">
                <WrapPanel x:Name="Chips" Orientation="Horizontal"/>
            </Border>
            <Border x:Name="BrowseBar" Background="{DynamicResource BarBack}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1" Padding="14,7" Visibility="Collapsed"
                    MouseLeftButtonDown="OnTitleDown" MouseMove="OnTitleMove" MouseLeftButtonUp="OnTitleUp">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="GridBtn" Content="Cover grid" Height="{DynamicResource KeyHeight}" Margin="0,0,9,0" Click="OnCoverGrid"
                                      ToolTip="Folders as equal book-cover tiles with their names underneath (right-click a cover to adjust it)"/>
                        <ToggleButton x:Name="OwnOnlyBtn" Content="Only this folder's own files" Height="{DynamicResource KeyHeight}" Margin="0,0,9,0" Click="OnOwnOnly"
                                      ToolTip="Off: a folder shows everything inside it, including its subfolders' files. On: only the files lying in the folder itself."/>
                        <TextBlock Text="Folders by" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                        <ComboBox x:Name="FolderSortBox" Width="140" Height="{DynamicResource KeyHeight}" Margin="0,0,6,0" SelectionChanged="OnFolderSortChanged">
                            <ComboBoxItem Content="Name" Tag="Name"/>
                            <ComboBoxItem Content="Total size" Tag="Size"/>
                            <ComboBoxItem Content="Last updated" Tag="Updated"/>
                            <ComboBoxItem Content="Most files" Tag="Files"/>
                            <ComboBoxItem Content="Most images" Tag="Images"/>
                            <ComboBoxItem Content="Most videos" Tag="Videos"/>
                            <ComboBoxItem Content="Most GIFs" Tag="Gifs"/>
                        </ComboBox>
                        <ToggleButton x:Name="FolderRevBtn" Style="{StaticResource ArrowToggle}" Width="30" Height="{DynamicResource KeyHeight}" Margin="0,0,9,0" Click="OnFolderSortChanged" ToolTip="Reverse the folder order"/>
                        <Button x:Name="DetailsBtn" Content="Details" Height="{DynamicResource KeyHeight}" Margin="0" Click="OnDetailsMenu" ToolTip="What each folder tile shows"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackBtn" Style="{StaticResource IconButton}" Content="&#xE72B;" Height="{DynamicResource KeyHeight}" Margin="0,0,2,0" Click="OnBack" ToolTip="Back (Alt+Left, Backspace)"/>
                        <Button x:Name="FwdBtn" Style="{StaticResource IconButton}" Content="&#xE72A;" Height="{DynamicResource KeyHeight}" Margin="0,0,2,0" Click="OnForward" ToolTip="Forward (Alt+Right)"/>
                        <Button x:Name="UpBtn" Style="{StaticResource IconButton}" Content="&#xE74A;" Height="{DynamicResource KeyHeight}" Margin="0,0,12,0" Click="OnUp" ToolTip="Up one folder (Alt+Up)"/>
                        <WrapPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border x:Name="ToolsBar" Background="{DynamicResource BarBack}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1" Padding="14,7" Visibility="Collapsed"/>
            <Border x:Name="Banner" Background="#5A4A1E" Padding="12,6" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel x:Name="BannerButtons" Orientation="Horizontal" DockPanel.Dock="Right"/>
                    <TextBlock x:Name="BannerText" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- the whole F3 status, one item per line -->
        <Border x:Name="DiagFull" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" MaxWidth="620" Padding="14,10"
                Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Copy" Padding="10,0" Height="24" Click="OnDiagCopy"/>
                    <Button Content="Close" Padding="10,0" Height="24" Margin="6,0,0,0" Click="OnDiagMore"/>
                </StackPanel>
                <TextBlock x:Name="DiagFullText" Foreground="#C8C8D0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
            </DockPanel>
        </Border>

        <!-- hover here to bring a hidden bar back; or use the little button -->
        <Border x:Name="HoverStrip" Grid.RowSpan="2" VerticalAlignment="Top" Height="6" Background="Transparent" Visibility="Collapsed"/>
        <Button x:Name="ShowBarBtn" Grid.RowSpan="2" Style="{StaticResource IconButton}" Content="&#xE70D;" Height="26" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,4,18,0" Background="#99000000" Visibility="Collapsed" ToolTip="Show the bar (H)" Click="OnShowBar"/>

        <!-- saved views: a pop-out from the Views button -->
        <Popup x:Name="SavedPopup" Grid.RowSpan="2" PlacementTarget="{Binding ElementName=ViewsBtn}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="2">
            <Border Margin="6,0,20,20" Width="390" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="12" Padding="8,10,8,8"
                    TextElement.FontFamily="{DynamicResource AppFont}" TextElement.Foreground="{DynamicResource Text}">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="Black"/></Border.Effect>
                <StackPanel>
                    <DockPanel Margin="8,0,4,8">
                        <Button DockPanel.Dock="Right" Content="Save this view…" Padding="10,1" Height="26" Click="OnSaveSearch" ToolTip="Keep everything about this view under a name"/>
                        <TextBlock x:Name="ViewTitle" Text="Saved views" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SavedList"/>
                    </ScrollViewer>
                    <TextBlock x:Name="SavedEmpty" Text="None yet. Save this view keeps everything about it (section, folder, switches, filters, order and look) under a name. Right-click a saved view to update, rename, move or delete it." Foreground="{DynamicResource Dim}" FontSize="11.5" TextWrapping="Wrap" Margin="8,2,6,6"/>
                    <Border Height="1" Background="{DynamicResource Edge}" Margin="4,6"/>
                    <WrapPanel Margin="4,2,0,0">
                        <Button Content="Return to default" Padding="10,1" Height="26" Margin="0,0,6,0" Click="OnReturnToDefaultBtn" ToolTip="This section's own sort, filters, layout and size"/>
                        <Button Content="Save as default" Padding="10,1" Height="26" Click="OnSaveAsDefaultBtn" ToolTip="Make how this section looks now its default"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- viewer -->
        <Grid x:Name="ViewerRoot" Grid.RowSpan="2" Background="{DynamicResource ViewerBack}" Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}">
            <Grid x:Name="PicHost" ClipToBounds="True" Background="Transparent" MouseWheel="OnViewerWheel" MouseLeftButtonDown="OnViewerDown" MouseRightButtonUp="OnViewerRightClick"
                  MouseMove="OnViewerMove" MouseLeftButtonUp="OnViewerUp" SizeChanged="OnViewerSize">
                <Image x:Name="Pic" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PicScale"/>
                            <TranslateTransform x:Name="PicMove"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="ViewerNote" Foreground="#C0C0C0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560"/>
            </Grid>
            <!-- video controls: square buttons the full height of the bar, the progress line, time, speed, loop, sound and volume -->
            <Border x:Name="VideoBar" VerticalAlignment="Bottom" Height="41" Margin="24,0,24,18" CornerRadius="10" Background="#8C1C1C20"
                    BorderBrush="#5A3A3A42" BorderThickness="1" Visibility="Collapsed" MaxWidth="1100" Opacity="0" TextElement.FontFamily="Segoe UI">
                <Grid x:Name="VideoBarGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="VPlayBtn" Grid.Column="0" Style="{StaticResource VBtn}" Content="&#xE769;" ToolTip="Play / pause (Space, or click the video)" Click="OnVPlay"/>
                    <Button Grid.Column="1" Style="{StaticResource VBtn}" Content="&#xE892;" ToolTip="Back a frame (9)" Click="OnVPrevFrame"/>
                    <Button Grid.Column="2" Style="{StaticResource VBtn}" Content="&#xE893;" ToolTip="Forward a frame (0)" Click="OnVNextFrame"/>
                    <local:VideoTimeline x:Name="VTimeline" Grid.Column="3" Margin="4,0"/>
                    <TextBlock x:Name="VTime" Grid.Column="4" Foreground="{DynamicResource Text}" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,10,0"/>
                    <Button x:Name="VSpeedBtn" Grid.Column="5" Style="{StaticResource VBtn}" FontFamily="Segoe UI" FontSize="13" Width="50" Content="1x" ToolTip="Speed ([ and ])" Click="OnVSpeedBtn"/>
                    <ToggleButton x:Name="VLoopBtn" Grid.Column="6" Style="{StaticResource VToggle}" Content="&#xE8EE;" IsChecked="True" ToolTip="Loop: play again from the start at the end (L)" Click="OnVLoop"/>
                    <Button x:Name="VMuteBtn" Grid.Column="7" Style="{StaticResource VBtn}" Content="&#xE767;" ToolTip="Sound on / off (M)" Click="OnVMute"/>
                    <StackPanel Grid.Column="8" Orientation="Horizontal" Margin="2,0,12,0">
                        <Slider x:Name="VVolume" Width="90" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="OnVVolume" ToolTip="Volume (Up and Down)" Focusable="False" IsMoveToPointEnabled="True"/>
                        <TextBlock x:Name="VVolText" Width="28" TextAlignment="Right" Foreground="{DynamicResource Text}" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" Text="80"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- the time under the mouse on the video's progress line, just above the bar -->
            <Border x:Name="VBubble" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="6,1,6,2" CornerRadius="4" Background="#D80C0C0E"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="VBubbleText" Foreground="White" FontSize="12"/>
            </Border>
            <!-- volume, or where the video is, for a moment after a key changes it -->
            <Border x:Name="ViewerOsd" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0" Padding="12,6" CornerRadius="6"
                    Background="#B4000000" IsHitTestVisible="False" Opacity="0">
                <TextBlock x:Name="ViewerOsdText" Foreground="White" FontSize="18" FontFamily="Segoe UI Semibold"/>
            </Border>
            <!-- the star (Favourites) and the slideshow with its settings arrow joined on: just the icons, the same size, as far from
                 the top as from the left; each brightens under the mouse (they come and go with the information box) -->
            <StackPanel x:Name="FavHost" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"
                        Visibility="{Binding Visibility, ElementName=InfoBox}" Opacity="{Binding Opacity, ElementName=InfoBox}">
                <Border Style="{StaticResource VPlainGroup}">
                    <Button x:Name="FavBtn" Style="{StaticResource VPlain}" Content="&#xE734;" Click="OnViewerFav" ToolTip="Add to Favourites"/>
                </Border>
                <!-- select the open file for file operations (X); lit in the accent colour when it is selected -->
                <Border Style="{StaticResource VPlainGroup}">
                    <Button x:Name="PickBtn" Style="{StaticResource VPlain}" Content="&#xE739;" Click="OnViewerPick" ToolTip="Select (X)"/>
                </Border>
                <Border Style="{StaticResource VPlainGroup}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SlideBtn" Style="{StaticResource VPlain}" Content="&#xE786;" Width="30" Padding="0" HorizontalContentAlignment="Right" Click="OnSlideshow" ToolTip="Slideshow from here (Space pauses, arrows step, Esc stops)"/>
                        <Button x:Name="SlideMoreBtn" Style="{StaticResource VPlain}" Content="&#xE70D;" FontSize="10" Width="18" Click="OnSlideMore" ToolTip="Slideshow settings: how long each picture shows, videos and GIFs, order"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border x:Name="InfoBox" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="10,6" CornerRadius="5"
                    Background="#8C000000" IsHitTestVisible="False">
                <TextBlock x:Name="InfoText" Foreground="#E8E8EC" FontSize="12" LineHeight="17" TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- keyboard shortcuts -->
        <Grid x:Name="MoveLayer" Grid.RowSpan="2" Background="#E6141418" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                <TextBlock x:Name="MoveTitle" Text="Moving thumbnails to your computer's own drive" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,0,0,8"/>
                <TextBlock x:Name="MoveNote" TextWrapping="Wrap" Foreground="{DynamicResource Dim}" Margin="0,0,0,14"
                           Text="One time only. The small thumbnails are being copied from the hard drive to this computer's fast drive, because a hard drive is very slow at fetching lots of thumbnails in a shuffled order. Ginkgo opens when it is done."/>
                <ProgressBar x:Name="MoveBar" Height="10" Minimum="0" Maximum="1"/>
                <TextBlock x:Name="MoveText" Foreground="{DynamicResource Dim}" Margin="0,8,0,0" FontFamily="Consolas"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="KeysLayer" Grid.RowSpan="2" Background="#CC000000" Visibility="Collapsed" MouseLeftButtonDown="OnKeysLayerDown">
            <Border Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="12" Padding="22,16" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnKeysPanelDown">
                <StackPanel>
                    <TextBlock x:Name="KeysTitle" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,0,0,10"/>
                    <Grid x:Name="KeysGrid"/>
                    <TextBlock Text="Press K or Esc to close" Foreground="{DynamicResource Dim}" Margin="0,12,0,0" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </DockPanel>
    <!-- the big logo: over the title bar and the top bar together (normal size in the bar when full screen) -->
    <local:LogoView x:Name="BigLogo" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,6,0,0" Visibility="Collapsed" ToolTip="Ginkgo"/>
    </Grid>
    </Border>
</Window>
