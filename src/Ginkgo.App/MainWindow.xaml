<Window x:Class="Ginkgo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Ginkgo.App"
        Title="Ginkgo" Width="1400" Height="900" MinWidth="760" MinHeight="480" Background="#121214"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="OnKey" StateChanged="OnStateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowEdge" BorderBrush="#4A4A54" BorderThickness="1">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- the picture grid fills the window; the bar floats over its top -->
        <Grid Grid.Row="0">
            <local:MasonryView x:Name="View"/>
            <ScrollBar x:Name="Scroll" Style="{StaticResource HoverBar}" Orientation="Vertical" HorizontalAlignment="Right" ValueChanged="OnBarChanged"/>
            <TextBlock x:Name="EmptyNote" Foreground="{StaticResource Dim}" FontSize="16" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Visibility="Collapsed"/>
        </Grid>

        <Border x:Name="StatusBar" Grid.Row="1" Background="{StaticResource Bar}" BorderBrush="#2A2A31" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <Button x:Name="UpdateBtn" DockPanel.Dock="Right" Content="Update view" Visibility="Collapsed" Margin="8,0,0,0" Padding="8,2" Click="OnUpdateView"/>
                <TextBlock x:Name="DiagText" DockPanel.Dock="Right" Foreground="#E0B060" FontFamily="Consolas" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource Text}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <ProgressBar x:Name="IdBar" DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="1" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- the top bar: also the window's title bar. It slides away when you scroll down. -->
        <StackPanel x:Name="BarHost" Grid.RowSpan="2" VerticalAlignment="Top">
            <StackPanel.RenderTransform><TranslateTransform x:Name="BarShift"/></StackPanel.RenderTransform>
            <Border x:Name="TopBar" Background="#C81C1C20" BorderBrush="#4A4A54" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleDown" MouseMove="OnTitleMove" MouseLeftButtonUp="OnTitleUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Orientation="Horizontal" Margin="14,17,0,17" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE700;" Height="32" Width="38" FontSize="14" Margin="0,3,10,3" VerticalAlignment="Center" ToolTip="Menu (Ctrl+B)" Click="OnSidebarToggle"/>
                        <TextBlock Text="Ginkgo" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}" Margin="0,3,19,3" VerticalAlignment="Center"/>
                        <Button x:Name="FoldersBtn" Content="Select folders" Height="32" Margin="0,3,9,3" VerticalAlignment="Center" Click="OnFolders"/>
                        <ToggleButton x:Name="ImagesBtn" Content="Images" Height="32" Margin="0,3,9,3" VerticalAlignment="Center" IsChecked="True" Click="OnFilterChanged"/>
                        <ToggleButton x:Name="GifsBtn" Content="GIFs" Height="32" Margin="0,3,9,3" VerticalAlignment="Center" IsChecked="True" Click="OnFilterChanged"/>
                        <ToggleButton x:Name="GeneralBtn" Content="General" Height="32" Margin="0,3,9,3" VerticalAlignment="Center" IsChecked="True" Click="OnFilterChanged" ToolTip="Show General files (G)"/>
                        <ToggleButton x:Name="NsfwBtn" Content="NSFW" Height="32" Margin="0,3,9,3" VerticalAlignment="Center" Click="OnFilterChanged" ToolTip="Show NSFW files (N)"/>
                        <ToggleButton x:Name="VeryBtn" Content="Very" Height="32" Margin="0,3,17,3" VerticalAlignment="Center" Click="OnFilterChanged" ToolTip="Show Very files (V)"/>
                        <TextBox x:Name="SearchBox" Width="170" Height="32" Margin="0,3,17,3" VerticalAlignment="Center" VerticalContentAlignment="Center" TextChanged="OnSearchChanged" ToolTip="Search file and folder names (/ or Ctrl+F)"/>
                        <ComboBox x:Name="SortBox" Width="150" Margin="0,3,9,3" Height="32" VerticalAlignment="Center" SelectionChanged="OnSortChanged">
                            <ComboBoxItem Content="Newest first seen" Tag="FirstSeen"/>
                            <ComboBoxItem Content="Newest modified" Tag="Modified"/>
                            <ComboBoxItem Content="Name A to Z" Tag="Name"/>
                            <ComboBoxItem Content="Largest file" Tag="SizeDesc"/>
                            <ComboBoxItem Content="Smallest file" Tag="SizeAsc"/>
                            <ComboBoxItem Content="Most pixels" Tag="Largest"/>
                            <ComboBoxItem Content="Random" Tag="Random"/>
                        </ComboBox>
                        <Button x:Name="ShuffleBtn" Content="Reshuffle" Height="32" Margin="0,3,9,3" VerticalAlignment="Center" Visibility="Collapsed" Click="OnReshuffle"/>
                        <Slider x:Name="SizeSlider" Width="120" Minimum="0" Maximum="1" Margin="10,3,12,3" VerticalAlignment="Center" ValueChanged="OnSizeChanged" ToolTip="Picture size (Ctrl + mouse wheel, + and -)"/>
                        <ToggleButton x:Name="RowsBtn" Content="Equal rows" Height="32" Margin="0,3,9,3" VerticalAlignment="Center" Click="OnLayoutChanged" ToolTip="Rows of equal height instead of equal-width columns (L)"/>
                        <Button x:Name="SettingsBtn" Style="{StaticResource IconButton}" Content="&#xE713;" Height="32" Width="38" FontSize="14" Margin="0,3,5,3" VerticalAlignment="Center" ToolTip="Settings" Click="OnSettings"/>
                        <Button x:Name="KeysBtn" Style="{StaticResource IconButton}" Content="&#xE765;" Height="32" Width="38" FontSize="14" Margin="0,3,5,3" VerticalAlignment="Center" ToolTip="Keyboard shortcuts (K)" Click="OnKeysClick"/>
                        <Button x:Name="HideBarBtn" Style="{StaticResource IconButton}" Content="&#xE70E;" Height="32" Width="38" FontSize="14" Margin="0,3,5,3" VerticalAlignment="Center" ToolTip="Hide this bar (H)" Click="OnHideBar"/>
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,10,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" Width="34" Height="30" FontSize="7" Margin="2,0,0,0" Click="OnMinimize"/>
                        <Button x:Name="MaxBtn" Style="{StaticResource IconButton}" Content="&#xE922;" Width="34" Height="30" FontSize="7" Margin="2,0,0,0" Click="OnMaximize"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Width="34" Height="30" FontSize="7" Margin="2,0,0,0" Click="OnClose"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="BrowseBar" Background="#C8191920" BorderBrush="#4A4A54" BorderThickness="0,0,0,1" Padding="14,7" Visibility="Collapsed"
                    MouseLeftButtonDown="OnTitleDown" MouseMove="OnTitleMove" MouseLeftButtonUp="OnTitleUp">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="GridBtn" Content="Cover grid" Height="30" Margin="0,0,9,0" Click="OnCoverGrid"
                                      ToolTip="Folders as equal book-cover tiles with their names underneath (right-click a cover to adjust it)"/>
                        <ToggleButton x:Name="OwnOnlyBtn" Content="Only this folder's own files" Height="30" Margin="0,0,9,0" Click="OnOwnOnly"
                                      ToolTip="Off: a folder shows everything inside it, including its subfolders' files. On: only the files lying in the folder itself."/>
                        <TextBlock Text="Folders by" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                        <ComboBox x:Name="FolderSortBox" Width="140" Height="30" Margin="0,0,6,0" SelectionChanged="OnFolderSortChanged">
                            <ComboBoxItem Content="Name" Tag="Name"/>
                            <ComboBoxItem Content="Total size" Tag="Size"/>
                            <ComboBoxItem Content="Last updated" Tag="Updated"/>
                            <ComboBoxItem Content="Most files" Tag="Files"/>
                            <ComboBoxItem Content="Most images" Tag="Images"/>
                            <ComboBoxItem Content="Most videos" Tag="Videos"/>
                            <ComboBoxItem Content="Most GIFs" Tag="Gifs"/>
                        </ComboBox>
                        <ToggleButton x:Name="FolderRevBtn" Content="&#xE8CB;" FontFamily="Segoe MDL2 Assets" Width="34" Height="30" Margin="0,0,9,0" Click="OnFolderSortChanged" ToolTip="Reverse the folder order"/>
                        <Button x:Name="DetailsBtn" Content="Details" Height="30" Margin="0" Click="OnDetailsMenu" ToolTip="What each folder tile shows"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackBtn" Style="{StaticResource IconButton}" Content="&#xE72B;" Width="34" Height="30" FontSize="12" Margin="0,0,2,0" Click="OnBack" ToolTip="Back (Alt+Left, Backspace)"/>
                        <Button x:Name="FwdBtn" Style="{StaticResource IconButton}" Content="&#xE72A;" Width="34" Height="30" FontSize="12" Margin="0,0,2,0" Click="OnForward" ToolTip="Forward (Alt+Right)"/>
                        <Button x:Name="UpBtn" Style="{StaticResource IconButton}" Content="&#xE74A;" Width="34" Height="30" FontSize="12" Margin="0,0,12,0" Click="OnUp" ToolTip="Up one folder (Alt+Up)"/>
                        <WrapPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border x:Name="Banner" Background="#5A4A1E" Padding="12,6" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel x:Name="BannerButtons" Orientation="Horizontal" DockPanel.Dock="Right"/>
                    <TextBlock x:Name="BannerText" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- hover here to bring a hidden bar back; or use the little button -->
        <Border x:Name="HoverStrip" Grid.RowSpan="2" VerticalAlignment="Top" Height="6" Background="Transparent" Visibility="Collapsed" Margin="0,0,150,0"/>
        <Button x:Name="ShowBarBtn" Grid.RowSpan="2" Style="{StaticResource IconButton}" Content="&#xE70D;" Width="34" Height="26" FontSize="11" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,4,18,0" Background="#99000000" Visibility="Collapsed" ToolTip="Show the bar (H)" Click="OnShowBar"/>

        <!-- side menu -->
        <Grid x:Name="SideLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="Scrim" Background="#88000000" MouseLeftButtonDown="OnScrimDown"/>
            <Border x:Name="Side" Width="260" HorizontalAlignment="Left" Background="#17171B" BorderBrush="#2E2E35" BorderThickness="0,0,1,0">
                <Border.RenderTransform><TranslateTransform x:Name="SideShift" X="-260"/></Border.RenderTransform>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6,0,14">
                        <Button Style="{StaticResource IconButton}" Content="&#xE700;" Height="28" Width="36" Margin="0,0,8,0" Click="OnSidebarToggle"/>
                        <TextBlock Text="Ginkgo" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                        <ToggleButton Style="{StaticResource SideItem}" Click="OnSideKeys">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="15"/><TextBlock Text="Keyboard shortcuts"/><TextBlock Text="  K" Foreground="{StaticResource Dim}"/></StackPanel>
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel>
                        <ToggleButton x:Name="NavHome" Style="{StaticResource SideItem}" IsChecked="True" Click="OnNav" Tag="Home">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="15"/><TextBlock Text="Home"/><TextBlock Text="  Ctrl+1" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/></StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavBrowse" Style="{StaticResource SideItem}" Click="OnNav" Tag="Browse">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="15"/><TextBlock Text="Browse"/><TextBlock Text="  Ctrl+2" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/></StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavFav" Style="{StaticResource SideItem}" Click="OnNav" Tag="Favourites">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="15"/><TextBlock Text="Favourites"/><TextBlock Text="  soon" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/></StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavTools" Style="{StaticResource SideItem}" Click="OnNav" Tag="Tools">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="15"/><TextBlock Text="Tools"/><TextBlock Text="  soon" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/></StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- viewer -->
        <Grid x:Name="ViewerRoot" Grid.RowSpan="2" Background="Black" Visibility="Collapsed" Focusable="True">
            <Grid x:Name="PicHost" ClipToBounds="True" Background="Black" MouseWheel="OnViewerWheel" MouseLeftButtonDown="OnViewerDown"
                  MouseMove="OnViewerMove" MouseLeftButtonUp="OnViewerUp" SizeChanged="OnViewerSize">
                <Image x:Name="Pic" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PicScale"/>
                            <TranslateTransform x:Name="PicMove"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="ViewerNote" Foreground="#C0C0C0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </Grid>
            <Border x:Name="InfoBox" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="10,6" CornerRadius="5"
                    Background="#8C000000" IsHitTestVisible="False">
                <TextBlock x:Name="InfoText" Foreground="#E8E8EC" FontSize="12" LineHeight="17" TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- keyboard shortcuts -->
        <Grid x:Name="MoveLayer" Grid.RowSpan="2" Background="#E6141418" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                <TextBlock Text="Moving thumbnails to your computer's own drive" FontSize="18" FontWeight="SemiBold" Foreground="#E4E4E8" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6" Margin="0,0,0,14"
                           Text="One time only. The small thumbnails are being copied from the hard drive to this computer's fast drive, because a hard drive is very slow at fetching lots of thumbnails in a shuffled order. Ginkgo opens when it is done."/>
                <ProgressBar x:Name="MoveBar" Height="10" Minimum="0" Maximum="1"/>
                <TextBlock x:Name="MoveText" Foreground="#9AA0A6" Margin="0,8,0,0" FontFamily="Consolas"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="KeysLayer" Grid.RowSpan="2" Background="#CC000000" Visibility="Collapsed" MouseLeftButtonDown="OnKeysLayerDown">
            <Border Background="#1E1E23" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="8" Padding="22,16" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnKeysPanelDown">
                <StackPanel>
                    <TextBlock x:Name="KeysTitle" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,10"/>
                    <Grid x:Name="KeysGrid"/>
                    <TextBlock Text="Press K or Esc to close" Foreground="{StaticResource Dim}" Margin="0,12,0,0" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
