<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Ginkgo</AssemblyName>
    <RootNamespace>Ginkgo.App</RootNamespace>
    <ApplicationIcon>Assets\ginkgo.ico</ApplicationIcon>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="LibVLCSharp" Version="3.9.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\ginkgo.png" />
    <Resource Include="Assets\ginkgo.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ginkgo.Core\Ginkgo.Core.csproj" />
    <ProjectReference Include="..\Ginkgo.Data\Ginkgo.Data.csproj" />
  </ItemGroup>
</Project>
