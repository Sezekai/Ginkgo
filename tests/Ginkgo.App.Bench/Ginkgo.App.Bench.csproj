<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ginkgo.App\ThumbLoader.cs" Link="ThumbLoader.cs" />
    <Compile Include="..\..\src\Ginkgo.App\MasonryView.cs" Link="MasonryView.cs" />
    <ProjectReference Include="..\..\src\Ginkgo.Core\Ginkgo.Core.csproj" />
    <ProjectReference Include="..\..\src\Ginkgo.Data\Ginkgo.Data.csproj" />
  </ItemGroup>
</Project>
